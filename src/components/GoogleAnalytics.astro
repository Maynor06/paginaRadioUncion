<script 
  is:inline 
  src="https://www.googletagmanager.com/gtag/js?id=G-WJMSS80Q1N">
</script>

<script is:inline data-astro-rerun>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }

  gtag('js', new Date());
  gtag('config', 'G-WJMSS80Q1N');

  // Mantén esto para que funcione la navegación entre páginas de la radio
  document.addEventListener('astro:page-load', () => {
    gtag('config', 'G-WJMSS80Q1N', {
      'page_path': window.location.pathname
    });
  });
</script>