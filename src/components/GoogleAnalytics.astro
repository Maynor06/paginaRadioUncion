<script 
  is:inline 
  src="https://www.googletagmanager.com/gtag/js?id=G-WJMSS80Q1N">
</script>

<script is:inline data-astro-rerun>
  // Definimos la interfaz localmente para que no marque error
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }

  gtag('js', new Date());
  // Importante: Tu ID real
  gtag('config', 'G-WJMSS80Q1N', {
    'debug_mode': true // Esto fuerza a que aparezca en el DebugView
  });

  // Soporte para ClientRouter (Navegación de Astro)
  document.addEventListener('astro:page-load', () => {
    gtag('config', 'G-WJMSS80Q1N', {
      'page_path': window.location.pathname
    });
  });
</script>